#!/bin/bash

# Blog generator wrapper script

# Usage: blog-gen-ta [command] [options]
#
# Failure contract: any step that fails — the tinyactor generation run —
# aborts the whole script with a nonzero exit and NEVER syncs static assets
# (rsync --delete) over a failed or partial tree. This is achieved with
# `set -euo pipefail`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Resolve the tinyactor CLI. The pinned vendored toolchain comes before a
# PATH install: tinyactor.lock names the toolchain that produces the site,
# and a global install may be a different (older or newer) commit.
# $TINYACTOR overrides everything, which is the supported way to generate
# against a local tinyactor checkout while developing it.
FROM_VENDOR=""
if [ -n "${TINYACTOR:-}" ]; then
    TINYACTOR="$TINYACTOR"
elif [ -x "$SCRIPT_DIR/vendor/tinyactor/tinyactor" ]; then
    TINYACTOR="$SCRIPT_DIR/vendor/tinyactor/tinyactor"
    FROM_VENDOR=1
elif command -v tinyactor >/dev/null 2>&1; then
    TINYACTOR="$(command -v tinyactor)"
else
    TINYACTOR="$SCRIPT_DIR/../tinyactor/tinyactor"
fi
if [ ! -x "$TINYACTOR" ]; then
    echo "Error: TinyActor CLI not found: $TINYACTOR" >&2
    echo "Run 'tinyactor vendor', set TINYACTOR, or put tinyactor on PATH." >&2
    exit 1
fi

# vendor/ is a git clone at the pinned sha, so it carries sources only:
# tavm and the C modules (*.dylib) are build products and are not tracked by
# tinyactor. Build them on first use (~1s); make is dependency-checked, so
# this is a no-op once they exist.
if [ -n "$FROM_VENDOR" ] && [ ! -x "$SCRIPT_DIR/vendor/tinyactor/tavm" ]; then
    echo "building vendored toolchain: make -C vendor/tinyactor" >&2
    make -s -C "$SCRIPT_DIR/vendor/tinyactor" >&2
fi


show_help() {
    cat << 'EOF'
Blog Generator (ta) - Generate blog content

Usage:
    blog-gen-ta generate              Generate all blog content (full rebuild)
    blog-gen-ta file <filename>       Generate a single blog post
    blog-gen-ta help                  Show this help message

Examples:
    blog-gen-ta generate                                    # Rebuild everything
    blog-gen-ta file 2024-01-15-my-new-post.md             # Generate specific post
    blog-gen-ta file content/2024-01-15-my-new-post.md     # Also works with path

Commands:
    generate    Full regeneration of all blog posts and index pages
    file        Generate only the specified blog post file
    help        Show this help message

Environment Variables:
        TINYACTOR   Optional path to the tinyactor CLI; otherwise uses the
                toolchain vendored by `tinyactor vendor` (pinned in
                tinyactor.lock), else PATH, else ../tinyactor/tinyactor


EOF
}

# Fail loudly when vendor/tinyactor is not the toolchain pinned in
# tinyactor.lock: a stale clone builds the site against a stdlib the lock
# never named, which is the silent failure the pin exists to prevent.
# Local-directory sources have no lock row, so they skip this (return 0).
check_toolchain_pin() {
    local lock="$SCRIPT_DIR/tinyactor.lock" vend="$SCRIPT_DIR/vendor/tinyactor" want got
    [ -f "$lock" ] || return 0
    [ -d "$vend" ] || return 0
    want="$(awk -F'\t' '$1 == "tinyactor" { print $4 }' "$lock")"
    [ -n "$want" ] || return 0
    got="$(git -C "$vend" rev-parse HEAD 2>/dev/null || true)"
    [ "$got" = "$want" ] && return 0
    echo "Error: vendor/tinyactor is ${got:-not a git clone}, tinyactor.lock pins $want" >&2
    echo "Run: tinyactor vendor" >&2
    exit 1
}

# gen.ta creates every output directory itself (file.mkdir_p) before the
# generator writes, so the wrapper invokes tinyactor exactly once and only
# syncs static assets after that single run succeeds.
#
# md4c is a C module compiled against the toolchain's ta.h (src-ta/Makefile).
# After a tinyactor upgrade the prebuilt lib/md4c.dylib can reference VM
# symbols the new tavm no longer exports, and the lazy dlopen fails mid-run
# ("cannot load C module 'md4c'"). The make rule is dependency-checked, so
# this is a no-op unless ta.h/glue.c/md4c source changed.
build_md4c() {
    local ext=dylib root
    [ "$(uname -s)" = "Darwin" ] || ext=so
    # Build against the headers of the toolchain that will load the module
    # (the TINYACTOR launcher's repo root). Fall back to the Makefile's
    # default TA_ROOT when TINYACTOR points at a stub/substitute binary.
    root="$(cd "$(dirname "$TINYACTOR")" && pwd)"
    [ -f "$root/ta.h" ] || root=""
    make -s -C "$SCRIPT_DIR/src-ta" "../lib/md4c.$ext" ${root:+TA_ROOT="$root"}
}

run_ta() {
    cd "$SCRIPT_DIR"
    # Page templates (and the atom feed) now live in dsl/templates.dsl; the
    # generated KL is spliced in front of the TA entry so template.* is
    # defined before use. Failure here aborts before any output is touched.
    "$SCRIPT_DIR/tools/build-dsl.sh" src-ta/gen.ta build/blog-gen.kl >&2
    "$TINYACTOR" run build/blog-gen.kl "$@"
}

sync_static() {
    echo "Syncing static assets..."
    rsync -a --delete "$SCRIPT_DIR/resources/public/static/" "$SCRIPT_DIR/generate/static/"
}

# Main
case "${1:-help}" in
    generate|all)
        check_toolchain_pin
        build_md4c
        run_ta generate
        sync_static
        ;;
    file)
        if [ -z "${2:-}" ]; then
            echo "Error: filename required"
            echo "Usage: blog-gen-ta file <filename>"
            exit 1
        fi
        check_toolchain_pin
        build_md4c
        run_ta file "$(basename "$2")"
        sync_static
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'blog-gen-ta help' for usage information"
        exit 1
        ;;
esac