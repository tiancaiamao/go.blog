#!/bin/bash

# Blog generator wrapper script (ta version — ta port of blog-gen)
# Usage: blog-gen-ta [command] [options]
#
# Failure contract: any step that fails — the tinyactor generation run —
# aborts the whole script with a nonzero exit and NEVER syncs static assets
# (rsync --delete) over a failed or partial tree. This is achieved with
# `set -euo pipefail`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TINYACTOR="${TINYACTOR:-/Users/genius/project/tinyactor/tinyactor}"

show_help() {
    cat << 'EOF'
Blog Generator (ta) - Generate blog content

Usage:
    blog-gen-ta generate              Generate all blog content (full rebuild)
    blog-gen-ta file <filename>       Generate a single blog post
    blog-gen-ta help                  Show this help message

Examples:
    blog-gen-ta generate                                    # Rebuild everything
    blog-gen-ta file 2024-01-15-my-new-post.md             # Generate specific post
    blog-gen-ta file content/2024-01-15-my-new-post.md     # Also works with path

Commands:
    generate    Full regeneration of all blog posts and index pages
    file        Generate only the specified blog post file
    help        Show this help message

Environment Variables:
    TINYACTOR   Path to the tinyactor CLI (default: /Users/genius/project/tinyactor/tinyactor)

EOF
}

# gen.ta creates every output directory itself (file.mkdir_p) before the
# generator writes, so the wrapper invokes tinyactor exactly once and only
# syncs static assets after that single run succeeds.
run_ta() {
    local cmd="$1"
    local arg="${2:-}"
    cd "$SCRIPT_DIR"
    if [ -n "$arg" ]; then
        "$TINYACTOR" run src-ta/gen.ta "$cmd" "$arg"
    else
        "$TINYACTOR" run src-ta/gen.ta "$cmd"
    fi
}

sync_static() {
    echo "Syncing static assets..."
    rsync -a --delete "$SCRIPT_DIR/resources/public/static/" "$SCRIPT_DIR/generate/static/"
}

# Main
case "${1:-help}" in
    generate|all)
        run_ta generate
        sync_static
        ;;
    file)
        if [ -z "${2:-}" ]; then
            echo "Error: filename required"
            echo "Usage: blog-gen-ta file <filename>"
            exit 1
        fi
        run_ta file "$(basename "$2")"
        sync_static
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'blog-gen-ta help' for usage information"
        exit 1
        ;;
esac