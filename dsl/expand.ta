// dsl/expand.ta — DSL -> KL form expansion.
//
// The compiler works on the pinned toolchain's untyped s-expr values
// (symbols / strings / ints / lists), so the whole pipeline stays in one
// representation: reader -> expand (this file) -> kl.write_program.
//
// Naming convention for generated KL:
//   template <name> (params) body...  -> (define template.<name> (lambda ...))
//   def <name> expr                   -> (define <name> expr)
// Helpers are prefixed tpl_ so they cannot collide with template names.
import "tinyactor:lib/bool"
import "tinyactor:lib/bootstrap/kl"

// die: build-time hard failure with a loud message.
fn die(msg) {
  print(str.concat("dsl compile: ", msg))
  str.from_int(1 / 0)
}

// sym_is: compare a form head against a marker that is awkward to quote
// directly in TA source (e.g. @ or *PI*).
fn sym_is(x, name) {
  if string?(x) { x == name }
  else if int?(x) { false }
  else { str.sym_to_str(x) == name }
}

// ---------- top level ----------

pub fn compile_program(forms) {
  let defs = def_names(forms)
  let pairs = compile_tops(forms, defs, nil, nil)
  let defs = car(pairs)
  kl.write_program(append(helper_forms(), defs))
}

pub fn stub_program(forms) {
  let defs = def_names(forms)
  let pairs = compile_tops(forms, defs, nil, nil)
  stub_text(car(cdr(pairs)))
}

fn compile_tops(forms, defs, deflist, stubs) {
  if null?(forms) {
    cons(reverse(deflist, nil), cons(reverse(stubs, nil), nil))
  } else {
    let f = car(forms)
    if bool.not(pair?(f)) {
      die("top-level form must be a list")
      nil
    } else {
      let head = car(f)
      if head == 'template {
        compile_template(forms, f, defs, deflist, stubs)
            } else if sym_is(head, "def") {
        compile_def(forms, f, defs, deflist, stubs)
      } else {
        die(str.concat("unknown top-level form: ", kl.write_flat(head)))
        nil
      }
    }
  }
}

fn compile_template(forms, f, defs, deflist, stubs) {
  if null?(cdr(f)) || null?(cdr(cdr(f))) {
    die("template needs a name and a parameter list")
    nil
  } else {
    let name = car(cdr(f))
    let params = car(cdr(cdr(f)))
    let body = cdr(cdr(cdr(f)))
    let kl_name = str.to_sym(str.concat("template.", str.sym_to_str(name)))
    let expr = cons('lambda, cons(params, cons(expand_nodes(body, defs), nil)))
    let def = cons('define, cons(kl_name, cons(expr, nil)))
    let stub = stub_line(str.sym_to_str(kl_name), params)
    compile_tops(cdr(forms), defs, cons(def, deflist), cons(stub, stubs))
  }
}

fn compile_def(forms, f, defs, deflist, stubs) {
  if null?(cdr(f)) || null?(cdr(cdr(f))) {
    die("def needs a name and an expression")
    nil
  } else {
    let name = car(cdr(f))
    let expr = expand_expr(car(cdr(cdr(f))), defs)
    let def = cons('define, cons(name, cons(cons('lambda, cons(nil, cons(expr, nil))), nil)))
    compile_tops(cdr(forms), defs, cons(def, deflist), stubs)
  }
}

fn stub_line(name, params) {
  str.concat("external fn ", str.concat(name,
    str.concat("(", str.concat(stub_params(params, 0), ") -> r"))))
}

fn stub_params(params, n) {
  if null?(params) {
    ""
  } else if null?(cdr(params)) {
    type_var(n)
  } else {
    str.concat(type_var(n), str.concat(", ", stub_params(cdr(params), n + 1)))
  }
}

fn type_var(n) {
  str.concat("t", str.from_int(n))
}

// def_names: zero-arg `def` values are emitted as KL lambdas, so every
// bare reference must be compiled to a call. Collect the names as a padded
// string (" a b ") so the expansion functions can carry one plain value
// through the whole recursion (no polymorphic list plumbing).
fn def_names(forms) {
    str.concat(" ", def_names_loop(forms))
}

fn def_names_loop(forms) {
  if null?(forms) {
    " "
  } else if pair?(car(forms)) && sym_is(car(car(forms)), "def") {
    str.concat(str.sym_to_str(car(cdr(car(forms)))),
      str.concat(" ", def_names_loop(cdr(forms))))
  } else {
    def_names_loop(cdr(forms))
  }
}

fn is_def(name, defs) {
  str.index_of(defs, str.concat(" ", str.concat(name, " "))) >= 0
}

fn stub_text(lines) {
  if null?(lines) {
    "// generated by dsl/main.ta -- no templates\n"
  } else {
    str.concat(car(lines), str.concat("\n", stub_text(cdr(lines))))
  }
}

// ---------- template body ----------

// expand_nodes: a sequence of template forms -> KL expression producing a
// flat list of Node values.
fn expand_nodes(xs, defs) {
  if null?(xs) {
    nil
  } else {
    let first = expand_node(car(xs), defs)
    let rest = expand_nodes(cdr(xs), defs)
    if null?(first) {
      rest
    } else if null?(rest) {
      first
    } else {
      cons('tpl_append, cons(first, cons(rest, nil)))
    }
  }
}

fn expand_node(x, defs) {
  if string?(x) {
    node_cons(text_node(x))
  } else if int?(x) {
    node_cons(cons('tuple, cons(cons('quote, cons('Text, nil)),
    cons(cons('str.from_int, cons(x, nil)), nil))))
  } else if pair?(x) {
    let head = car(x)
    if head == '__bq {
      expand_nodes(cdr(x), defs)
    } else if head == '__uq {
      unquote_expr(cdr(x), defs)
    } else if head == '__splice {
      unquote_expr(cdr(x), defs)
    } else if head == 'list {
      expand_nodes(cdr(x), defs)
    } else if head == 'let {
      expand_let(x, defs)
    } else if head == 'if {
      expand_if(x, defs)
    } else if head == 'for {
      expand_for_node(x, defs)
    } else if head == 'raw {
      node_cons(cons('tuple, cons(cons('quote, cons('Raw, nil)),
            cons(str_expr(cdr(x), defs), nil))))
    } else if sym_is(head, "comment") || sym_is(head, "*COMMENT*") {
      node_cons(raw_wrap(str.concat("<!--", str.concat(str_expr(cdr(x), defs), "-->"))))
    } else if head == 'cdata {
      node_cons(raw_wrap(str.concat("<![CDATA[", str.concat(str_expr(cdr(x), defs), "]]>"))))
    } else if sym_is(head, "*PI*") {
      node_cons(raw_wrap(pi_expr(cdr(x), defs)))
    } else if sym_is(head, "*ENTITY*") {
      node_cons(raw_wrap(entity_expr(cdr(x), defs)))
    } else if sym_is(head, "*TOP*") {
      expand_nodes(cdr(x), defs)
    } else if sym_is(head, "@") || head == 'quote {
      die(str.concat("misplaced template form: ", kl.write_flat(head)))
      nil
    } else {
      expand_element(x, defs)
    }
  } else {
    die(str.concat("bare symbol is not a template node: ", str.sym_to_str(x)))
    nil
  }
}

fn text_node(s) {
  cons('tuple, cons(cons('quote, cons('Text, nil)), cons(s, nil)))
}

fn raw_wrap(s) {
  cons('tuple, cons(cons('quote, cons('Raw, nil)), cons(s, nil)))
}

fn node_cons(node_expr) {
  // a nodelist expression: (cons <node form> nil)
  call2('cons, node_expr, nil)
}

fn unquote_expr(items, defs) {
  if null?(items) || bool.not(null?(cdr(items))) {
    die("unquote takes exactly one expression")
    nil
  } else {
    cons('tpl_child, cons(expand_expr(car(items), defs), nil))
  }
}

fn expand_let(x, defs) {
  if null?(cdr(x)) || null?(cdr(cdr(x))) {
    die("let needs bindings and a body")
    nil
  } else {
    let binds = car(cdr(x))
    cons('let, cons(expand_binds(binds, defs), cons(expand_nodes(cdr(cdr(x)), defs), nil)))
  }
}

fn expand_binds(binds, defs) {
  if null?(binds) {
    nil
  } else {
    let b = car(binds)
    if bool.not(pair?(b)) || null?(cdr(b)) || bool.not(null?(cdr(cdr(b)))) {
      die("let binding must be (name expr)")
      nil
    } else {
      cons(car(b), cons(expand_expr(car(cdr(b)), defs), expand_binds(cdr(binds), defs)))
    }
  }
}

fn expand_if(x, defs) {
  if null?(cdr(x)) || null?(cdr(cdr(x))) || null?(cdr(cdr(cdr(x)))) {
    die("if needs condition, then and else")
    nil
  } else {
    cons('if, cons(expand_expr(car(cdr(x)), defs),
    cons(expand_nodes(cons(car(cdr(cdr(x))), nil), defs),
    cons(expand_nodes(cons(car(cdr(cdr(cdr(x)))), nil), defs), nil))))
  }
}

fn expand_for_node(x, defs) {
  if null?(cdr(x)) || null?(cdr(cdr(x))) || null?(cdr(cdr(cdr(x)))) {
    die("for needs (for name in seq body...)")
    nil
  } else {
    let name = car(cdr(x))
    let seq = car(cdr(cdr(cdr(x))))
    let body = cdr(cdr(cdr(cdr(x))))
    cons('tpl_flatmap,
    cons(cons('lambda, cons(cons(name, nil), cons(expand_nodes(body, defs), nil))),
    cons(expand_expr(seq, defs), nil)))
  }
}

fn expand_element(x, defs) {
  let tag = car(x)
  if bool.not(string?(tag)) && bool.not(int?(tag)) && bool.not(pair?(tag)) {
    // tag is a symbol
    let rest = cdr(x)
        let has_attrs = bool.not(null?(rest)) && pair?(car(rest)) && sym_is(car(car(rest)), "@")
    let attr_expr = if has_attrs { list_expr(expand_attrs(cdr(car(rest)), defs)) } else { nil }
    let children = if has_attrs { cdr(rest) } else { rest }

    let elem = cons('tuple, cons(cons('quote, cons('Elem, nil)),
    cons(str.sym_to_str(tag), cons(attr_expr, cons(expand_nodes(children, defs), nil)))))
    node_cons(elem)
  } else {
    die(str.concat("invalid element tag: ", kl.write_flat(tag)))
    nil
  }
}

// expand_attrs: both surface forms normalize to a KL list of Attr tuples.
//   (@ class "x" id "y" checked)     flat (value must be string/int/,expr)
//   (@ (class "x") (id "y") (checked)) SXML shape (annotations ignored)
fn expand_attrs(items, defs) {
  if null?(items) {
    nil
  } else {
    let a = car(items)
    if pair?(a) && sym_is(car(a), "@") {
      expand_attrs(cdr(items), defs) // nested @ is annotations: parsed, not rendered
    } else if pair?(a) {
      let name = str.sym_to_str(car(a))
      let value = if null?(cdr(a)) {
        nil
      } else if null?(cdr(cdr(a))) {
        attr_value(car(cdr(a)), defs)
      } else {
        die("attribute form must be (name value?)")
        nil
      }
      cons(attr_tuple(name, value), expand_attrs(cdr(items), defs))
    } else if string?(a) || int?(a) {
      die("attribute value without a name")
      nil
    } else if pair?(cdr(items)) && value_carrier(car(cdr(items))) {
      let value = attr_value(car(cdr(items)), defs)
      cons(attr_tuple(str.sym_to_str(a), value), expand_attrs(cdr(cdr(items)), defs))
    } else {
      cons(attr_tuple(str.sym_to_str(a), nil), expand_attrs(cdr(items), defs))
    }
  }
}

fn value_carrier(x) {
  if string?(x) || int?(x) {
    true
  } else if pair?(x) && car(x) == '__uq {
    true
  } else {
    false
  }
}

fn attr_value(x, defs) {
  if string?(x) {
    x
  } else if int?(x) {
    cons('str.from_int, cons(x, nil))
  } else if pair?(x) && car(x) == '__uq {
    if null?(cdr(x)) {
      die("empty unquote in attribute")
      nil
    } else {
      cons('tpl_attr_val, cons(expand_expr(car(cdr(x)), defs), nil))
    }
  } else {
    cons('tpl_attr_val, cons(expand_expr(x, defs), nil))
  }
}

fn list_expr(forms) {
  if null?(forms) {
    nil
  } else {
    cons('cons, cons(car(forms), cons(list_expr(cdr(forms)), nil)))
  }
}

fn attr_tuple(name, value) {
  cons('tuple, cons(cons('quote, cons('Attr, nil)),
  cons(name, cons(value, nil))))
}

fn attr_list(items) {
  if null?(items) {
    nil
  } else {
    cons(car(items), attr_list(cdr(items)))
  }
}

// ---------- expressions ----------

fn expand_expr(x, defs) {
  if pair?(x) {
    let head = car(x)
    if head == '__bq {
      expand_nodes(cdr(x), defs)
    } else if head == '__uq || head == '__splice {
      if null?(cdr(x)) {
        die("empty unquote")
        nil
      } else {
        expand_expr(car(cdr(x)), defs)
      }
    } else if head == 'quote {
      x
    } else if head == 'cat {
      cat_expr(cdr(x), defs)
    } else if head == 'list {
      cons('cons, cons(expand_expr(car(cdr(x)), defs),
      cons(list_tail(cdr(cdr(x)), defs), nil)))
    } else if head == 'lambda {
      cons('lambda, cons(car(cdr(x)), cons(expand_expr(car(cdr(cdr(x))), defs), nil)))
    } else if head == 'for {
      expand_for_expr(x, defs)
    } else {
      map_expr(x, defs)
    }
  } else if null?(x) || string?(x) || int?(x) {
    x
    } else if is_def(kl.write_flat(x), defs) {
    // zero-arg def: a bare DSL reference means a KL call
    cons(x, nil)
  } else {
    x
  }
}

fn map_expr(x, defs) {
  if null?(x) {
    nil
  } else {
    // the head is a function name, never a value reference
    cons(car(x), map_expr(cdr(x), defs))
  }
}

fn list_tail(xs, defs) {
  if null?(xs) {
    nil
  } else {
    cons('cons, cons(expand_expr(car(xs), defs), cons(list_tail(cdr(xs), defs), nil)))
  }
}

fn cat_expr(xs, defs) {
  if null?(xs) {
    ""
  } else if null?(cdr(xs)) {
    expand_expr(car(xs), defs)
  } else {
    cons('str.concat, cons(expand_expr(car(xs), defs), cons(cat_expr(cdr(xs), defs), nil)))
  }
}

fn expand_for_expr(x, defs) {
  if null?(cdr(x)) || null?(cdr(cdr(x))) || null?(cdr(cdr(cdr(x)))) {
    die("for needs (for name in seq expr)")
    nil
  } else {
    let name = car(cdr(x))
    let seq = car(cdr(cdr(cdr(x))))
    let body = car(cdr(cdr(cdr(cdr(x)))))
    cons('tpl_map,
    cons(cons('lambda, cons(cons(name, nil), cons(expand_expr(body, defs), nil))),
    cons(expand_expr(seq, defs), nil)))
  }
}

// str_expr: a compile-time string expression; pieces may be unquoted.
fn str_expr(items, defs) {
  if null?(items) {
    ""
  } else if null?(cdr(items)) {
    let x = car(items)
    if string?(x) {
      x
    } else if pair?(x) && car(x) == '__uq {
      expand_expr(car(cdr(x)), defs)
    } else {
      die("expected string or ,expr here")
      nil
    }
  } else {
    cons('str.concat, cons(str_expr(cons(car(items), nil), defs),
    cons(str_expr(cdr(items), defs), nil)))
  }
}

fn pi_expr(items, defs) {
  if null?(items) {
    die("*PI* needs a target")
    "\"\""
  } else {
    let target = car(items)
    let content = if null?(cdr(items)) { "" } else { car(cdr(items)) }
    str.concat("<?", str.concat(str_expr(cons(target, nil), defs),
    str.concat(" ", str.concat(str_expr(cons(content, nil), defs), "?>"))))
  }
}

fn entity_expr(items, defs) {
  if null?(items) {
    die("*ENTITY* needs public and system ids")
    "\"\""
  } else {
    let pub = car(items)
    let sys = if null?(cdr(items)) { "" } else { car(cdr(items)) }
    str.concat("<!ENTITY ", str.concat(str_expr(cons(pub, nil), defs),
    str.concat(" ", str.concat(str_expr(cons(sys, nil), defs), ">"))))
  }
}

// ---------- emitted runtime ----------

// Form builders. TA unannotated functions are monomorphic, so each arity gets
// its own polymorphic builder (distinct type variables for each position).
fn call1(f : a, x : b) { cons(f, cons(x, nil)) }
fn call2(f : a, x : b, y : c) { cons(f, cons(x, cons(y, nil))) }

fn helper_forms() {
  [
    def_form('tpl_append, ['a 'b],
      if_expr(call1('null?, 'a), 'b,
        call2('cons, call1('car, 'a),
               call2('tpl_append, call1('cdr, 'a), 'b)))),

    def_form('tpl_atom, ['v],
      if_expr(call1('tuple?, 'v), 'v,
        if_expr(call1('string?, 'v),
            call2('tuple, list_of(['quote 'Text]), 'v),
          if_expr(call1('int?, 'v),
            call2('tuple, list_of(['quote 'Text]), call1('str.from_int, 'v)),
            'v)))),

    def_form('tpl_flatten, ['v],
      if_expr(call1('null?, 'v), [],
        if_expr(call1('pair?, 'v),
          call2('tpl_append, call1('tpl_flatten, call1('car, 'v)),
                             call1('tpl_flatten, call1('cdr, 'v))),
          call2('cons, call1('tpl_atom, 'v), nil)))),

    def_form('tpl_child, ['v],
      call1('tpl_flatten, 'v)),

    def_form('tpl_flatmap, ['f 'xs],
      if_expr(call1('null?, 'xs), [],
        call2('tpl_append, call1('f, call1('car, 'xs)),
                           call2('tpl_flatmap, 'f, call1('cdr, 'xs))))),

    def_form('tpl_map, ['f 'xs],
      if_expr(call1('null?, 'xs), [],
        call2('cons, call1('f, call1('car, 'xs)),
                     call2('tpl_map, 'f, call1('cdr, 'xs))))),

    def_form('tpl_attr_val, ['v],
      if_expr(call1('int?, 'v), call1('str.from_int, 'v), 'v))
  ]
}

fn list_of(xs : List(a)) -> List(a) {
  if null?(xs) { [] } else { cons(car(xs), list_of(cdr(xs))) }
}

fn def_form(name : a, params : b, body : c) {
  cons('define, cons(name, cons(cons('lambda, cons(params, cons(body, nil))), nil)))
}

fn if_expr(c : a, t : b, e : c) {
  cons('if, cons(c, cons(t, cons(e, nil))))
}

fn reverse(xs : List(a), acc : List(a)) -> List(a) {
  if null?(xs) { acc } else { reverse(cdr(xs), cons(car(xs), acc)) }
}

fn append(a : List(x), b : List(x)) -> List(x) {
  if null?(a) { b } else { cons(car(a), append(cdr(a), b)) }
}
