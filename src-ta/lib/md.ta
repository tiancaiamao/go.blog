// md module: markdown -> html Node tree (byte-identical to cora's wrap.c).
//
// md4c.events(path) (C module, src-ta/md4c/glue.c) produces a flat,
// document-ordered event list; md.fold turns it into the html Node ADT and
// md.html(path) = fold(events(path)). The C layer does NO tree assembly —
// this module is where cora's lib/md4c/wrap.c render logic lives.
//
// Event grammar (must stay in sync with src-ta/md4c/glue.c; every event is
// a pair (sym . payload)):
//   (e-p . nil)      (l-p)                      <p>
//   (e-quote . nil)  (l-quote)                  <blockquote>
//   (e-ul . nil)     (l-ul)                     <ul>
//   (e-ol . start)   (l-ol)                     <ol> — start attr only when
//                                               start != 1; start 0 (markdown
//                                               "0. item") renders start="0"
//   (e-li . mark)    (l-li)                     <li> — mark 0 => plain li;
//                                               'x'(120) / 'X'(88) => checked
//   (e-h . level)    (l-h)                      <h1>..<h6>
//   (e-code . lang)  (l-code)                   <pre><code [class="language-L"]>
//                                               (lang nil => no class); the
//                                               single l-code event closes
//                                               code and pre (cora does two
//                                               render_verbatim_leave)
//   (e-hr . nil)                               self-contained <hr /> (no leave)
//   (e-table . nil) / (e-thead . nil) / (e-tbody . nil) / (e-tr . nil)
//   + matching l-* events                     <table>/<thead>/<tbody>/<tr>
//   (s-em . nil) (s-strong . nil) (s-code . nil) (s-del . nil) + matching
//   sl-* events                              <em>/<strong>/<code>/<del>
//   (s-a . (href . title))  (sl-a)             <a href=... [title=...]>
//   (s-img . src)         (sl-img)             <img src=...> (no children)
//   (text . s)                                 escaped text node (also
//                                               carries soft-break "\n")
//   (br . nil)                                <br />
//
// md4c configuration is byte-identical to cora/lib/md4c/wrap.c: parser flags
// MD_FLAG_STRIKETHROUGH | MD_FLAG_TASKLISTS; MD_TEXT_HTML dropped (cora:
// "it conflicts with sxml"); MD_TEXT_SOFTBR falls through to the plain
// text case like cora's default clause — md4c delivers it as the 1-byte
// string "\n", so soft line breaks survive as text nodes; MD_BLOCK_DOC/
// HTML emit nothing; MD_BLOCK_TH/TD emit nothing.
//
// Serialization: html.render / html.render_list (cora sxml->xml). A top-level
// post is a List(Node); the empty document renders "".
//
// Fold mechanics mirror cora's MD_HTML {curr, stack} exactly:
//   curr  — cons list of the current element's contents (REVERSED order:
//           the most recent child is the head, like cora's append_curr);
//   stack — ONE cell per open element: ((tag . info) . saved-cur), where
//           info is the open-time payload (ol start / li mark / code lang
//           / a href+title) only consumed at close time, and saved-cur is
//           the parent's content list frozen at enter time. cora's
//           render_verbatim_leave does (cons (reverse curr) old): reversing
//           then re-consing back is a no-op on the final value, so the ta
//           close uses a plain cons (byte-identical, and avoids the O(n^2)
//           per-leave reversal).

import html

// ---- close-time element builders (cora's special cases) ----

// md_li_node: cora render_open_li_block.
//
// cora's sxml for a task item is (li (@ (class "task-list-item"))
// (input (@ (type "checkbox") (class "task-list-item-checkbox")
// disabled [checked]) body...): the input comes first, then the li body.
// The input's attrs render in cora's order — type, class, disabled,
// [checked only when the mark is x/X] — with disabled/checked as
// VALUELESS attrs (bare symbols in cora's attr list render as
// " name", see html.attr_flag). Attribute/child ORDER is part of the
// byte-identical contract (verified against baseline 2022.md.html):
//   <li class="task-list-item"><input type="checkbox"
//        class="task-list-item-checkbox" disabled [checked] />BODY</li>
// NOTE: every attr-list tail must be a proper list — consing an Attr
// ATOM as a tail makes an improper list that hd_attrs crashes on.
// NOTE: `or` as a symbol in a condition expression is a parser bug (it
// swallows the rest of the file); use explicit comparisons.
fn md_li_node(mark, body) {
  if mark == 0 {
    html.elem("li", nil, body)
  } else {
    let checked_tail = if mark == 120 {
      cons(html.attr_flag("checked"), nil)
    } else {
      if mark == 88 {
        cons(html.attr_flag("checked"), nil)
      } else {
        nil
      }
    }
    let input_attrs = cons(
      html.attr("type", "checkbox"),
      cons(html.attr("class", "task-list-item-checkbox"),
           cons(html.attr_flag("disabled"), checked_tail)))
    let input = html.elem("input", input_attrs, nil)
    html.elem("li", cons(html.attr("class", "task-list-item"), nil),
              cons(input, body))
  }
}

// md_ol_node: cora render_open_ol_block — start attribute only when
// start != 1 (start 0 renders as start="0").
fn md_ol_node(start, body) {
  if start == 1 {
    html.elem("ol", nil, body)
  } else {
    html.elem("ol", cons(html.attr("start", str.from_int(start)), nil), body)
  }
}

// md_h_node: cora head[] = {"h1", ... "h6"}.
fn md_h_node(level, body) {
  let tag = if level == 1 {
    "h1"
  } else {
    if level == 2 {
      "h2"
    } else {
      if level == 3 {
        "h3"
      } else {
        if level == 4 {
          "h4"
        } else {
          if level == 5 {
            "h5"
          } else {
            "h6"
          }
        }
      }
    }
  }
  html.elem(tag, nil, body)
}

// md_code_node: cora render_open_code_block — <code [class="language-L"]>.
fn md_code_node(lang, body) {
  let attrs = if null?(lang) {
    nil
  } else {
    cons(html.attr("class", str.concat("language-", lang)), nil)
  }
  html.elem("code", attrs, body)
}

// md_a_node: cora render_open_a_span — attr order href, then title (only
// when present).
fn md_a_node(href_title, body) {
  let href = car(href_title)
  let title = cdr(href_title)
  let attrs = if null?(title) {
    cons(html.attr("href", href), nil)
  } else {
    cons(html.attr("href", href), cons(html.attr("title", title), nil))
  }
  html.elem("a", attrs, body)
}

// md_rev: reverse a node list (the fold accumulates in reverse order).
fn md_rev(lst, acc) {
  if null?(lst) {
    acc
  } else {
    md_rev(cdr(lst), cons(car(lst), acc))
  }
}

// md_build: (tag . info) + REVERSED body -> node. info is the open-time
// payload (nil for plain blocks). The top-level frame has tag nil: its
// "element" is the document's top-level List(Node).
//
// SPECIAL CASES — byte-identical to cora's wrap.c, QUIRKS INCLUDED. cora
// builds several of these as sxml lists whose second cell is NOT an
// (@ ...) attrs list, so sxml->xml falls into the plain-element clause
// and renders the pieces as CHILD ELEMENTS. Reproduced here as explicit
// Elem/Text/Raw nodes (all verified against
// src-ta/test/baseline/md/*.html):
//   li task   : <li class="task-list-item">INPUT BODY</li> — the input
//               first, then the body (cora's curr is reversed at close);
//               input attrs type/class/disabled[checked], the last two
//               valueless (see md_li_node)
//   code+lang : <code><class>language-L</class><@></@>BODY</code> — the
//               class element and the stray @ element are CHILDREN, in
//               that order, before the body. The @ has body (nil) in
//               cora — a one-element list, hence NOT the self-closing
//               form: modeled as Elem("@", nil, [Raw("")])
//   a         : <a href="H" [title="T"]>BODY</a> — a NORMAL element
//               (cora's (@ (href H) (title T)) attrs list is proper);
//               BODY is the link text events only
//   img       : <img src="S">ALT</img> — src attr + the alt-text events
//               as body (md4c delivers alt text via text callbacks
//               between the img enter/leave)
fn md_build(frame, body) {
  let b = md_rev(body, nil)
  let tag = car(frame)
  let info = cdr(frame)
  if null?(tag) {
    b
  } else {
    if tag == "ol" {
      md_ol_node(info, b)
    } else {
      if tag == "li" {
        md_li_node(info, b)
      } else {
        if tag == "h" {
          md_h_node(info, b)
        } else {
                    if tag == "code" {
            if null?(info) {
              html.elem("code", nil, b)
            } else {
              let class_el = html.elem("class", nil,
                  cons(html.text(str.concat("language-", info)), nil))
              html.elem("code", nil,
                  cons(class_el, cons(html.elem("@", nil,
                      cons(html.raw(""), nil)), b)))
            }
          } else {
            if tag == "a" {
              md_a_node(info, b)
            } else {
              if tag == "img" {
                html.elem("img", cons(html.attr("src", info), nil), b)
              } else {
                html.elem(tag, nil, b)
              }
            }
          }
        }
      }
    }
  }
}

// md_close: cora render_verbatim_leave — pop the frame cell, build the
// element from the inner content list, prepend it to the PARENT's saved
// content list. State: (cur . stack); each stack cell is
// ((tag . info) . saved-cur): exactly one cell per open element, the
// saved-cur being the parent's content list that was current at enter
// time (children accumulate most-recent-first and are reversed once in
// md_build).
fn md_close(state) {
  let cur = car(state)
  let cell = car(cdr(state))
  let node = md_build(car(cell), cur)
  cons(cons(node, cdr(cell)), cdr(cdr(state)))
}

// md_enter: cora render_verbatim_enter — save (frame . cur) as one stack
// cell, start a fresh (empty) content list; info is the open-time payload
// (nil for plain blocks).
fn md_enter(tag, info, state) {
  cons(nil, cons(cons(cons(tag, info), car(state)), cdr(state)))
}

// ---- fold: one event ----

// md_fold_ev: state (cur . stack) -> state. Unknown events are ignored
// (defensive; the glue layer only emits the documented grammar).
fn md_fold_ev(ev, state) {
  let name = str.sym_to_str(car(ev))
  let p = cdr(ev)
  match name {
    "e-p" -> md_enter("p", nil, state)
    "l-p" -> md_close(state)
    "e-quote" -> md_enter("blockquote", nil, state)
    "l-quote" -> md_close(state)
    "e-ul" -> md_enter("ul", nil, state)
    "l-ul" -> md_close(state)
    "e-ol" -> md_enter("ol", p, state)
    "l-ol" -> md_close(state)
    "e-li" -> md_enter("li", p, state)
    "l-li" -> md_close(state)
    "e-h" -> md_enter("h", p, state)
    "l-h" -> md_close(state)
    "e-code" -> {
      let s1 = md_enter("pre", nil, state)
      md_enter("code", p, s1)
    }
    "l-code" -> {
      let s1 = md_close(state) // closes <code>
      md_close(s1)             // closes <pre> (cora: two verbatim_leave)
    }
    "e-hr" -> {
      let cur = car(state)
      cons(cons(html.elem("hr", nil, nil), cur), cdr(state))
    }
    "e-table" -> md_enter("table", nil, state)
    "l-table" -> md_close(state)
    "e-thead" -> md_enter("thead", nil, state)
    "l-thead" -> md_close(state)
    "e-tbody" -> md_enter("tbody", nil, state)
    "l-tbody" -> md_close(state)
    "e-tr" -> md_enter("tr", nil, state)
    "l-tr" -> md_close(state)
    "s-em" -> md_enter("em", nil, state)
    "sl-em" -> md_close(state)
    "s-strong" -> md_enter("strong", nil, state)
    "sl-strong" -> md_close(state)
    "s-code" -> md_enter("code", nil, state)
    "sl-code" -> md_close(state)
    "s-del" -> md_enter("del", nil, state)
    "sl-del" -> md_close(state)
    "s-a" -> md_enter("a", p, state)
    "sl-a" -> md_close(state)
    "s-img" -> md_enter("img", p, state)
    "sl-img" -> md_close(state)
    "text" -> {
      let cur = car(state)
      cons(cons(html.text(p), cur), cdr(state))
    }
    "br" -> {
      let cur = car(state)
      cons(cons(html.elem("br", nil, nil), cur), cdr(state))
    }
    _ -> state
  }
}

// ---- fold: whole list ----

fn md_fold_loop(evs, state) {
  if null?(evs) {
    state
  } else {
    md_fold_loop(cdr(evs), md_fold_ev(car(evs), state))
  }
}

// ---- public API ----

// fold: event list (from md4c.events) -> List(Node) (nil for the empty
// document).
pub fn fold(evs) {
  // Initial state: empty content list, stack holding the single dummy
  // frame cell ((nil . nil) . nil) — the document root.
  let st = md_fold_loop(evs, cons(nil, cons(cons(cons(nil, nil), nil), nil)))
  // md_close pops the dummy frame: the top-level "element" is the
  // document's top-level List(Node) (md_build's nil-tag case).
  let closed = md_close(st)
  car(car(closed))
}

// html: markdown file path -> List(Node); nil if the file cannot be read.
pub fn html(path) {
  let evs = md4c.events(path)
  if null?(evs) {
    nil
  } else {
    fold(evs)
  }
}

