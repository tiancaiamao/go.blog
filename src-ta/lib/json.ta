// json module: JSON parser + value accessors, pure ta (no C deps).
//
// Values are represented by the Json ADT:
//   JStr(s) / JInt(n) / JFloat(f) / JBool(b) / JNull / JArr(items) / JObj(fields)
// Objects store fields as a list of (name . value) pairs; a missing key
// comes back as nil (distinct from an explicit JNull).
//
// The parser is a small recursive-descent scanner over str.char_at bytes.
// Malformed input prints a message and crashes the process (1 / 0), a
// fail-fast choice that fits the blog-generator toolchain: a broken
// index.json should abort the build, not silently produce empty pages.
//
// The module is self-contained (no `import list`): TA module imports fall
// back to <cwd>/lib/ which is not under our control here, so the few list
// helpers needed are re-implemented with a js_ prefix.

pub type Json {
  JStr(s)
  JInt(n)
  JFloat(f)
  JBool(b)
  JNull
  JArr(items)
  JObj(fields)
}

// ---- small list helpers (self-contained) ----

fn js_len(lst) {
  if null?(lst) {
    0
  } else {
    1 + js_len(cdr(lst))
  }
}

fn js_nth(lst, n) {
  if null?(lst) {
    nil
  } else {
    if pair?(lst) {
      if n == 0 {
        car(lst)
      } else {
        js_nth(cdr(lst), n - 1)
      }
    } else {
      nil
    }
  }
}

fn js_rev(lst) {
  js_rev_acc(nil, lst)
}

fn js_rev_acc(acc, lst) {
  if null?(lst) {
    acc
  } else {
    js_rev_acc(cons(car(lst), acc), cdr(lst))
  }
}

// ---- parser internals ----

fn js_fail(src, pos, msg) {
  print(str.concat("json parse error at ", str.concat(str.from_int(pos),
  str.concat(": ", msg))))
  1 / 0
}

fn js_is_digit(c) {
  c >= 48 && c <= 57
}

fn js_skip_ws(src, pos) {
  let c = str.char_at(src, pos)
  if c == 32 || c == 10 || c == 13 || c == 9 {
    js_skip_ws(src, pos + 1)
  } else {
    pos
  }
}

// js_parse_value: returns (value . next_pos)
fn js_parse_value(src, pos) {
  let p = js_skip_ws(src, pos)
  let c = str.char_at(src, p)
  if c == 123 {
    js_parse_object(src, p + 1)
  } else {
    if c == 91 {
      js_parse_array(src, p + 1)
    } else {
      if c == 34 {
        js_parse_string(src, p + 1)
      } else {
        if c == 116 {
          js_parse_literal(src, p, "true", JBool(true))
        } else {
          if c == 102 {
            js_parse_literal(src, p, "false", JBool(false))
          } else {
            if c == 110 {
              js_parse_literal(src, p, "null", JNull)
            } else {
              if c == 45 {
                js_parse_number(src, p)
              } else {
                if js_is_digit(c) {
                  js_parse_number(src, p)
                } else {
                  js_fail(src, p, "unexpected character in value")
                }
              }
            }
          }
        }
      }
    }
  }
}

fn js_parse_literal(src, pos, kw, val) {
  let p = js_skip_ws(src, pos)
  let n = str.length(kw)
  if str.substr(src, p, n) == kw {
    cons(val, p + n)
  } else {
    js_fail(src, p, str.concat("invalid literal, expected ", kw))
  }
}

// js_parse_string: pos is just past the opening quote.
// Returns (JStr(s) . next_pos).
fn js_parse_string(src, pos) {
  let r = js_parse_string_body(src, pos, "")
  cons(JStr(car(r)), cdr(r))
}

fn js_parse_string_body(src, pos, acc) {
  let c = str.char_at(src, pos)
  if c == 34 {
    cons(acc, pos + 1)
  } else {
    if c == 92 {
      let e = str.char_at(src, pos + 1)
      if e == 117 {
        // \uXXXX — parse 4 hex digits, emit UTF-8 bytes
        let cp = js_parse_hex4(src, pos + 2)
        let acc2 = str.concat(acc, js_utf8(cp))
        js_parse_string_body(src, pos + 6, acc2)
      } else {
        let ch = js_escape_byte(src, pos + 1)
        js_parse_string_body(src, pos + 2, str.concat(acc, str.chr(ch)))
      }
    } else {
      if c == -1 {
        js_fail(src, pos, "unterminated string")
      } else {
        js_parse_string_body(src, pos + 1, str.concat(acc, str.chr(c)))
      }
    }
  }
}

// js_escape_byte: byte value for a one-char JSON escape at `pos`.
fn js_escape_byte(src, pos) {
  let e = str.char_at(src, pos)
  if e == 34 {
    34
  } else {
    if e == 92 {
      92
    } else {
      if e == 47 {
        47
      } else {
        if e == 98 {
          8
        } else {
          if e == 102 {
            12
          } else {
            if e == 110 {
              10
            } else {
              if e == 114 {
                13
              } else {
                if e == 116 {
                  9
                } else {
                  js_fail(src, pos, "invalid escape")
                }
              }
            }
          }
        }
      }
    }
  }
}

// js_hex: nibble value of a hex digit char, or -1.
fn js_hex(c) {
  if c >= 48 && c <= 57 {
    c - 48
  } else {
    if c >= 65 && c <= 70 {
      c - 65 + 10
    } else {
      if c >= 97 && c <= 102 {
        c - 97 + 10
      } else {
        -1
      }
    }
  }
}

fn js_parse_hex4(src, pos) {
  let h1 = js_hex(str.char_at(src, pos))
  let h2 = js_hex(str.char_at(src, pos + 1))
  let h3 = js_hex(str.char_at(src, pos + 2))
  let h4 = js_hex(str.char_at(src, pos + 3))
  if h1 < 0 || h2 < 0 || h3 < 0 || h4 < 0 {
    js_fail(src, pos, "invalid \\u escape")
  } else {
    ((h1 * 16 + h2) * 16 + h3) * 16 + h4
  }
}

// js_utf8: UTF-8 byte string for a BMP code point.
fn js_utf8(cp) {
  if cp < 128 {
    str.chr(cp)
  } else {
    if cp < 2048 {
      str.concat(str.chr(192 + cp / 64), str.chr(128 + cp % 64))
    } else {
      str.concat(str.chr(224 + cp / 4096),
      str.concat(str.chr(128 + (cp / 64) % 64), str.chr(128 + cp % 64)))
    }
  }
}

// js_parse_array: pos is just past '['.
// Returns (JArr(items) . next_pos).
fn js_parse_array(src, pos) {
  let p = js_skip_ws(src, pos)
  if str.char_at(src, p) == 93 {
    cons(JArr(nil), p + 1)
  } else {
    let r = js_parse_array_items(src, p, nil)
    cons(JArr(car(r)), cdr(r))
  }
}

fn js_parse_array_items(src, pos, acc) {
  let vr = js_parse_value(src, pos)
  let v = car(vr)
  let p = js_skip_ws(src, cdr(vr))
  let c = str.char_at(src, p)
  if c == 44 {
    js_parse_array_items(src, p + 1, cons(v, acc))
  } else {
    if c == 93 {
      cons(js_rev(cons(v, acc)), p + 1)
    } else {
      js_fail(src, p, "expected ',' or ']' in array")
    }
  }
}

// js_parse_object: pos is just past '{'.
// Returns (JObj(fields) . next_pos); fields are (name . value) pairs.
fn js_parse_object(src, pos) {
  let p = js_skip_ws(src, pos)
  if str.char_at(src, p) == 125 {
    cons(JObj(nil), p + 1)
  } else {
    let r = js_parse_object_fields(src, p, nil)
    cons(JObj(car(r)), cdr(r))
  }
}

fn js_parse_object_fields(src, pos, acc) {
  let p = js_skip_ws(src, pos)
  if str.char_at(src, p) == 125 {
    cons(acc, p + 1)
  } else {
    if str.char_at(src, p) == 34 {
      let sr = js_parse_string(src, p + 1)
      let name = js_str_value(car(sr))
      let p2 = js_skip_ws(src, cdr(sr))
      if str.char_at(src, p2) == 58 {
        let vr = js_parse_value(src, p2 + 1)
        let field = cons(name, car(vr))
        let p3 = js_skip_ws(src, cdr(vr))
        let c = str.char_at(src, p3)
        if c == 44 {
          js_parse_object_fields(src, p3 + 1, cons(field, acc))
        } else {
          if c == 125 {
            cons(js_rev(cons(field, acc)), p3 + 1)
          } else {
            js_fail(src, p3, "expected ',' or '}' in object")
          }
        }
      } else {
        js_fail(src, p2, "expected ':' after object key")
      }
    } else {
      js_fail(src, p, "expected string key in object")
    }
  }
}

// ---- numbers ----

fn js_parse_number(src, pos) {
  let end = js_num_end(src, pos)
  let tok = str.substr(src, pos, end - pos)
  if js_is_float_tok(tok) {
    let f = js_float_value(tok)
    if f == nil {
      js_fail(src, pos, "invalid number")
    } else {
      cons(JFloat(f), end)
    }
  } else {
    cons(JInt(str.to_int(tok)), end)
  }
}

fn js_num_end(src, pos) {
  let c = str.char_at(src, pos)
  if js_is_digit(c) {
    js_num_end(src, pos + 1)
  } else {
    if c == 46 || c == 101 || c == 69 {
      js_num_end(src, pos + 1)
    } else {
      if c == 43 || c == 45 {
        js_num_end(src, pos + 1)
      } else {
        pos
      }
    }
  }
}

fn js_is_float_tok(tok) {
  if str.index_of(tok, ".") >= 0 {
    true
  } else {
    if str.index_of(tok, "e") >= 0 {
      true
    } else {
      str.index_of(tok, "E") >= 0
    }
  }
}

fn js_pow10f(k : int) -> float {
  if k <= 0 {
    1.0
  } else {
    10.0 * js_pow10f(k - 1)
  }
}

fn js_float_from_parts(neg, int_part, frac_part, frac_digits, exp) {
  let base = int_part + (frac_part + 0.0) / js_pow10f(frac_digits)
  let scaled = if exp >= 0 {
    base * js_pow10f(exp)
  } else {
    base / js_pow10f(0 - exp)
  }
  if neg == 1 {
    0.0 - scaled
  } else {
    scaled
  }
}

// js_float_value: parse a float token; nil if malformed (second '.').
fn js_float_value(tok) {
  let neg = if str.char_at(tok, 0) == 45 { 1 } else { 0 }
  let body = if neg == 1 {
    str.substr(tok, 1, str.length(tok) - 1)
  } else {
    tok
  }
  let e1 = str.index_of(body, "e")
  let e2 = str.index_of(body, "E")
  let epos = if e1 >= 0 {
    if e2 >= 0 {
      if e1 < e2 { e1 } else { e2 }
    } else {
      e1
    }
  } else {
    e2
  }
  let mant = if epos >= 0 { str.substr(body, 0, epos) } else { body }
  let exp = if epos >= 0 {
    str.to_int(str.substr(body, epos + 1, str.length(body) - epos - 1))
  } else {
    0
  }
  let dot = str.index_of(mant, ".")
  if dot >= 0 {
    let tail = str.substr(mant, dot + 1, str.length(mant) - dot - 1)
    if str.index_of(tail, ".") >= 0 {
      nil
    } else {
      js_float_from_parts(neg, str.to_int(str.substr(mant, 0, dot)),
      str.to_int(tail), str.length(tail), exp)
    }
  } else {
    js_float_from_parts(neg, str.to_int(mant), 0, 0, exp)
  }
}

// ---- public API ----

// parse: parse a JSON document from a string; fails the process on error.
pub fn parse(src) {
  let r = js_parse_value(src, 0)
  let v = car(r)
  let p = js_skip_ws(src, cdr(r))
  if str.length(src) > p {
    js_fail(src, p, "trailing data after JSON value")
  } else {
    v
  }
}

// load: read a file and parse it.
pub fn load(path) {
  let s = file.read(path)
  if null?(s) {
    print(str.concat("json.load: cannot read ", path))
    1 / 0
  } else {
    parse(s)
  }
}

fn js_str_value(v) {
  car(cdr(v))
}

pub fn is_string(v) {
  if pair?(v) && car(v) == 'JStr { true } else { false }
}

pub fn is_number(v) {
  if pair?(v) && (car(v) == 'JInt || car(v) == 'JFloat) { true } else { false }
}

pub fn is_bool(v) {
  if pair?(v) && car(v) == 'JBool { true } else { false }
}

pub fn is_null(v) {
  v == 'JNull
}

pub fn is_array(v) {
  if pair?(v) && car(v) == 'JArr { true } else { false }
}

pub fn is_object(v) {
  if pair?(v) && car(v) == 'JObj { true } else { false }
}

// kind: symbol describing the value ('string/'number/'bool/'null/
// 'array/'object), or nil for a non-Json value.
pub fn kind(v) {
  if is_string(v) {
    'string
  } else {
    if is_number(v) {
      'number
    } else {
      if is_bool(v) {
        'bool
      } else {
        if is_null(v) {
          'null
        } else {
          if is_array(v) {
            'array
          } else {
            if is_object(v) {
              'object
            } else {
              nil
            }
          }
        }
      }
    }
  }
}

pub fn string_value(v) {
  if is_string(v) { car(cdr(v)) } else { nil }
}

pub fn int_value(v) {
  if pair?(v) && car(v) == 'JInt { car(cdr(v)) } else { nil }
}

pub fn float_value(v) {
  if pair?(v) && car(v) == 'JFloat { car(cdr(v)) } else { nil }
}

// number_value: int for JInt, float for JFloat.
pub fn number_value(v) {
  if pair?(v) && (car(v) == 'JInt || car(v) == 'JFloat) {
    car(cdr(v))
  } else {
    nil
  }
}

pub fn bool_value(v) {
  if is_bool(v) { car(cdr(v)) } else { nil }
}

pub fn array_size(v) {
  if is_array(v) {
    js_len(car(cdr(v)))
  } else {
    0
  }
}

// array_get: 0-based element access; out-of-range returns nil.
pub fn array_get(v, i) {
  if is_array(v) {
    js_nth(car(cdr(v)), i)
  } else {
    nil
  }
}

pub fn array_items(v) {
  if is_array(v) { car(cdr(v)) } else { nil }
}

// object_get: field value, or nil when missing or not an object.
pub fn object_get(v, key) {
  if is_object(v) {
    js_field(car(cdr(v)), key)
  } else {
    nil
  }
}

fn js_field(fields, key) {
  if null?(fields) {
    nil
  } else {
    let f = car(fields)
    if car(f) == key {
      cdr(f)
    } else {
      js_field(cdr(fields), key)
    }
  }
}

pub fn object_fields(v) {
  if is_object(v) { car(cdr(v)) } else { nil }
}
