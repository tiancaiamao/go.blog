// src-ta/test/md_test.ta — md module acceptance tests (spec A2).
//
// Every expectation is a golden fixture: src-ta/test/baseline/md/<name>.html.
// md.html(path) must serialize byte-identical to it.
//
// EXCEPTION — tables. The legacy renderer had no tables support
// (MD_FLAG_TABLES), so a markdown table reached the output as one run-on
// paragraph of "|" text. The TA generator parses tables for real, so two
// fixtures here are goldens from the TA generator itself:
//   raft-2F1A    the real post with a table (re-rendered by TA)
//   table        hand-written fixture covering alignment + inline spans +
//                escaping + an empty cell (see table.md)
//
// The post set covers the markdown constructs the legacy renderer special-cased:
//   200-lines-gc  code blocks WITH language class (language-C/lisp/...)
//   chibi-scheme1 code blocks with language class
//   2022          task lists (li class, checkbox input, checked)
//   raft-2F1A     tables + a blockquote (TA-generated, see above)
//   7900xtx-local-ai  images (img src attr, alt text children)
//   klambda       nested blockquotes (indented quotes)
//   2018          mixed content; ordered list starts at 1 (no start attr)
//   ol-start2     ordered list starting "2." (ol start="2") — fixture
//   ol-start0     ordered list starting "0." (ol start="0"; legacy renderer
//                 omits start only when == 1) — fixture
//   table         table alignment / escaping / empty cell — fixture
//
// The ol-start*/table fixtures are hand-written inputs living next to their
// baselines (no real post has an ordered list with start != 1; the TA
// generator is the only thing that renders tables at all).

//
// Asserts pass silently; a failed assertion prints the divergence and
// crashes the process (1 / 0) so the runner exits non-zero.
// Run from the go.blog repo root:  tinyactor run src-ta/test/md_test.ta

import "go.blog:src-ta/lib/md"
import "tinyactor:lib/html"

fn fail(msg) {
  print(str.concat("MD TEST FAIL: ", msg))
  1 / 0
}

fn assert_html_eq(name, content_path, baseline_path) {
  let actual = html.render_list(md.html(content_path))
  let expected = file.read(baseline_path)
  if null?(expected) {
    fail(str.concat("baseline missing: ", baseline_path))
  } else {
    if str.eq(actual, expected) {
      print(str.concat("ok ", name))
    } else {
      print(str.concat("  actual:   ", actual))
      print(str.concat("  expected: ", expected))
      fail(str.concat("byte mismatch: ", name))
    }
  }
}

fn main() {
  assert_html_eq("200-lines-gc", "./content/200-lines-gc.md",
                 "./src-ta/test/baseline/md/200-lines-gc.md.html")
  assert_html_eq("chibi-scheme1", "./content/chibi-scheme1.md",
                 "./src-ta/test/baseline/md/chibi-scheme1.md.html")
  assert_html_eq("2022", "./content/2022.md",
                 "./src-ta/test/baseline/md/2022.md.html")
  assert_html_eq("raft-2F1A", "./content/raft-2F1A.md",
                 "./src-ta/test/baseline/md/raft-2F1A.md.html")
  assert_html_eq("7900xtx-local-ai", "./content/7900xtx-local-ai.md",
                 "./src-ta/test/baseline/md/7900xtx-local-ai.md.html")
  assert_html_eq("klambda", "./content/klambda.md",
                 "./src-ta/test/baseline/md/klambda.md.html")
  assert_html_eq("2018", "./content/2018.md",
                 "./src-ta/test/baseline/md/2018.md.html")
  assert_html_eq("ol-start2", "./src-ta/test/baseline/md/ol-start2.md",
                 "./src-ta/test/baseline/md/ol-start2.md.html")
  assert_html_eq("ol-start0", "./src-ta/test/baseline/md/ol-start0.md",
                 "./src-ta/test/baseline/md/ol-start0.md.html")
  assert_html_eq("table", "./src-ta/test/baseline/md/table.md",
                 "./src-ta/test/baseline/md/table.md.html")
  print("MD TEST PASS")
}