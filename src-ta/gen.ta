// src-ta/gen.ta — blog generator entry point (ta port of blog-gen).
//
// Usage (from the go.blog repo root, via the blog-gen-ta wrapper):
//   tinyactor run src-ta/gen.ta generate        full site -> generate/
//   tinyactor run src-ta/gen.ta file <name>     single post + index/
//                                               category/tags/feed refresh
//   tinyactor run src-ta/gen.ta help            usage
//
// argv comes from the VM builtin vm.get_arg (same precedent as
// tinyactor's lib/driver.ta and lib/serve.ta — no import needed).
//
// The generator creates every output directory itself: before
// core.generate / core.generate_file writes anything, ensure_dirs() runs
// fs.mkdir_p on the output root and on every ./generate/<post>,
// ./generate/category/<name> and ./generate/tags/<name> — tag names may
// contain '/', e.g. call/cc, and mkdir_p handles the nesting. A mkdir_p
// failure is a hard error (core.co_die => crash, nonzero exit), matching
// the project's failure convention, so the blog-gen-ta wrapper never
// syncs static assets over a partially-created output tree.

import core
import fs

fn each(lst, f) {
  if null?(lst) {
    nil
  } else {
    f(car(lst))
    each(cdr(lst), f)
  }
}

// ensure_dir: create one output directory; hard-fail on error.
fn ensure_dir(d) {
  if fs.mkdir_p(d) == 1 {
    nil
  } else {
    core.co_die(str.concat("gen: cannot create directory ", d))
  }
}

// ensure_dirs: create the output root and every post/category/tags
// directory the generator writes into (names may nest, e.g. tags/call/cc).
fn ensure_dirs(index, category, tags) {
  let root = "./generate/"
  ensure_dir(root)
  each(index, fn(item) {
  ensure_dir(str.concat(root, core.get_string_from_item(item, "File")))
  })
  each(category, fn(entry) {
  ensure_dir(str.concat(str.concat(root, "category/"), car(entry)))
  })
  each(tags, fn(entry) {
  ensure_dir(str.concat(str.concat(root, "tags/"), car(entry)))
  })
}

fn run_generate() {
  let index = core.parse_index_file("./content/index.json")
  let category = core.build_category(index)
  let tags = core.build_tags(index)
  ensure_dirs(index, category, tags)
  core.generate("./generate/", index, category, tags)
}

fn run_file(name) {
  let index = core.parse_index_file("./content/index.json")
  let category = core.build_category(index)
  let tags = core.build_tags(index)
  ensure_dirs(index, category, tags)
  core.generate_file("./generate/", index, category, tags, name)
}

fn show_help() {
  print("Blog Generator (ta) - Generate blog content")
  print("")
  print("Usage:")
  print("    blog-gen-ta generate              Generate all blog content (full rebuild)")
  print("    blog-gen-ta file <filename>       Generate a single blog post")
  print("    blog-gen-ta help                  Show this help message")
}

fn main() {
  let cmd = vm.get_arg(0)
  if str.eq(cmd, "generate") {
    run_generate()
  } else {
    if str.eq(cmd, "all") {
      run_generate()
    } else {
      if str.eq(cmd, "file") {
        run_file(vm.get_arg(1))
      } else {
        show_help()
      }
    }
  }
}